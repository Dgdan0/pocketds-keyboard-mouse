<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnEnableKeyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="1. Enable PocketDS keyboard in system settings" />

        <Button
            android:id="@+id/btnSwitchKeyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="2. Switch active keyboard" />

        <Button
            android:id="@+id/btnEnableAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="3. Enable cursor control (Accessibility)" />

        <EditText
            android:id="@+id/testField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="username"
            android:inputType="text"
            android:hint="Username - tap to test typing and autofill" />

        <!-- A username/password pair, because autofill services key off the
             password field: a lone text box is not recognisably a login. -->
        <EditText
            android:id="@+id/testPasswordField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:inputType="textPassword"
            android:hint="Password - tap to test autofill suggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Theme"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/themeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioThemeSystem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="System" />

            <RadioButton
                android:id="@+id/radioThemeLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Light" />

            <RadioButton
                android:id="@+id/radioThemeDark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dark" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Bottom-screen panel"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Only present while PocketDS Keyboard is selected — switching to another keyboard removes it completely. It opens automatically when you focus a field, and tucks itself back down to a thin strip at the top of the bottom screen when focus is lost (tap the strip to bring it back, or the ⌄ button in the panel to tuck it away yourself)."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Trackpad"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkInvertScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Invert scroll direction" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Mouse pointer"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hide the pointer after this long without using the trackpad. It reappears the moment you touch the trackpad again."
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/cursorIdleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioIdle5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5s" />

            <RadioButton
                android:id="@+id/radioIdle10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10s" />

            <RadioButton
                android:id="@+id/radioIdle15"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="15s" />

            <RadioButton
                android:id="@+id/radioIdle30"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30s" />

            <RadioButton
                android:id="@+id/radioIdleNever"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Never" />

        </RadioGroup>

        <CheckBox
            android:id="@+id/checkHideOnScreenTouch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hide the pointer when I touch the top screen" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Best-effort: Android doesn't report other apps' touches directly, so this infers them from what apps report being clicked or scrolled. An app animating on its own can occasionally trigger it — the pointer always comes straight back on the next trackpad touch."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Debug trace"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="What the app actually did, newest at the bottom. If something misbehaves, come straight here and hit Refresh — the trace is recorded continuously, so it still shows what happened."
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRefreshDebug"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Refresh" />

            <Button
                android:id="@+id/btnClearDebug"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear" />

            <Button
                android:id="@+id/btnCopyDebug"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Copy" />

        </LinearLayout>

        <TextView
            android:id="@+id/debugTrace"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="8dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="1Password"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Android won't let a third-party app set another app as the autofill service for security reasons — that first step has to be done manually below. After that, 1Password's suggestions appear in a strip above the keys whenever you focus a login field.

1Password opens on the top screen, not the bottom one. It cannot unlock itself down there: the system destroys any fingerprint prompt whose app isn't the top task, and it reads that from the top screen. The keyboard stays up while you look, so you can copy above and paste below."
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAutofillSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open autofill service settings" />

        <Button
            android:id="@+id/btnOpenOnePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open 1Password" />

    </LinearLayout>

</ScrollView>
